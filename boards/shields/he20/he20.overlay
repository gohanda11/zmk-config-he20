#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <input/he_processors.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan_forwarder;
        zmk,physical-layout = &he20_physical_layout;
    };

    he20_physical_layout: he20_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "HE20";
        transform = <&default_transform>;
        kscan = <&kscan_forwarder>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  100  100       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  100       0     0     0>
            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  100  200       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  200       0     0     0>
            , <&key_physical_attrs 100 100    0  300       0     0     0>
            , <&key_physical_attrs 100 100  100  300       0     0     0>
            , <&key_physical_attrs 100 100  200  300       0     0     0>
            , <&key_physical_attrs 100 100  300  300       0     0     0>
            , <&key_physical_attrs 100 100  400  300       0     0     0>
            , <&key_physical_attrs 200 100    0  400       0     0     0>
            , <&key_physical_attrs 200 100  300  400       0     0     0>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <3>;
        map = <
            // Row 0: HE1      HE2      HE3      HE4      HE5
               RC(0,4)  RC(0,6)  RC(0,7)  RC(0,5)  RC(0,3)
            // Row 1: HE6      HE7      HE8      HE9      HE10
               RC(0,2)  RC(0,1)  RC(0,0)  RC(1,4)  RC(1,6)
            // Row 2: HE11     HE12     HE13     HE14     HE15
               RC(1,2)  RC(1,1)  RC(1,0)  RC(1,3)  RC(1,5)
            // Row 3: HE16     HE17     HE18     HE19     HE20
               RC(2,7)  RC(2,4)  RC(2,2)  RC(2,1)  RC(2,3)
            // Row 4: HE21(2U)          HE22(2U)
               RC(2,6)  RC(2,0)
        >;
    };

    he_kscan: kscan {
        compatible = "he,kscan-multiplexer";
        resolution = <12>;
        address-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>,  // MUX_SELECT_0 (A) = P1.13/D8
                        <&gpio1 14 GPIO_ACTIVE_HIGH>,   // MUX_SELECT_1 (B) = P1.14/D9
                        <&gpio1 15 GPIO_ACTIVE_HIGH>;   // MUX_SELECT_2 (C) = P1.15/D10
        address-to-read-delay = <5>;
        wait-period-idle = <5>;
        wait-period-press = <1>;
        kscan-forwarder = <&kscan_forwarder>;
        polyfit = <0x408b2298 0xc1167de4 0x40fed831 0xc02b2742 0x3f404977 0x3bd693e5>;
        calibrate;

        // AM1: 8 keys (HE8,HE7,HE6,HE5,HE1,HE4,HE2,HE3)
        group0 {
            io-channels = <&adc 1>;  // AIN1 = P0.03/A1 = MUX_OUT_1
            address-range-min = <0>;
            address-range-max = <7>;
            switch-height = <3300>;
        };

        // AM2: 7 keys (HE13,HE12,HE11,HE14,HE9,HE15,HE10) + X7 unused
        group1 {
            io-channels = <&adc 4>;  // AIN4 = P0.28/A2 = MUX_OUT_2
            address-range-min = <0>;
            address-range-max = <7>;
            switch-height = <3300>;
        };

        // AM3: 7 keys (HE22,HE19,HE18,HE20,HE17,(unused),HE21,HE16) + X5 unused
        group2 {
            io-channels = <&adc 5>;  // AIN5 = P0.29/A3 = MUX_OUT_3
            address-range-min = <0>;
            address-range-max = <7>;
            switch-height = <3300>;
        };
    };

    he_input_listener: he_input_listener {
        compatible = "he,input-listener";
        device = <&he_kscan>;
        input-processors = <&he_pass 0>;
    };
};

&he_pass {
    keymap-size = <22>;
};

&adc {
    status = "okay";
};
